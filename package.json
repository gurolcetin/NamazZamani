{
  "name": "NamazDefteri",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "android:apk": "cd android && ./gradlew assembleRelease",
    "android:clean": "cd android && ./gradlew clean",
    "ios:archive": "xcodebuild -workspace ios/NamazDefteri.xcworkspace -scheme NamazDefteri -configuration Release -archivePath ios/build/NamazDefteri.xcarchive archive",
    "ios:export": "xcodebuild -exportArchive -archivePath ios/build/NamazDefteri.xcarchive -exportOptionsPlist ios/ExportOptions.plist -exportPath ios/build/export",
    "ios:clean": "rm -rf ios/build",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "iphone15PM": "react-native run-ios --simulator='iPhone 15 Pro Max'",
    "run-pods": "cd ios && pod install && cd .. && npx react-native run-ios",
    "postinstall": "node scripts/postinstall-fixes.js"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.2.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.4.5",
    "@react-native-community/push-notification-ios": "^1.11.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-vector-icons/fontawesome6": "^12.2.0",
    "@react-native-vector-icons/material-design-icons": "^12.4.0",
    "@react-native/new-app-screen": "0.82.1",
    "@react-navigation/bottom-tabs": "^7.5.0",
    "@react-navigation/drawer": "^7.6.0",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/native-stack": "^7.5.1",
    "@react-navigation/stack": "^7.5.0",
    "@reduxjs/toolkit": "^2.9.2",
    "hijri-date": "^0.2.2",
    "i18next": "^25.6.0",
    "i18next-http-backend": "^3.0.2",
    "react": "19.1.1",
    "react-hook-form": "^7.65.0",
    "react-i18next": "^16.2.0",
    "react-native": "0.82.1",
    "react-native-bootsplash": "^7.3.1",
    "react-native-compass-heading": "^2.0.2",
    "react-native-device-info": "^14.1.1",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "^2.29.0",
    "react-native-google-mobile-ads": "^16.0.0",
    "react-native-haptic-feedback": "^2.3.3",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-permissions": "^5.4.2",
    "react-native-push-notification": "^8.1.1",
    "react-native-reanimated": "^4.1.3",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.18.0",
    "react-native-svg": "^15.14.0",
    "react-native-worklets": "^0.6.1",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "typescript-util-functions": "^1.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.1.3",
    "@react-native-community/cli-platform-android": "^20.1.3",
    "@react-native-community/cli-platform-ios": "^20.1.3",
    "@react-native/babel-preset": "0.82.1",
    "@react-native/eslint-config": "0.82.1",
    "@react-native/metro-config": "0.82.1",
    "@react-native/typescript-config": "0.82.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.1",
    "@types/react-native-push-notification": "^8.1.2",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.1",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "reactNativeVectorIcons": {
    "fontDir": "src/rnvi-fonts"
  }
}
